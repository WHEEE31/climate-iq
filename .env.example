# All settings are optional — the app runs with zero configuration.
# Copy to .env only if you want to override a default.

# Port the server listens on. Most hosts set this automatically.
PORT=5000

# Log verbosity: debug | info | warn | error
LOG_LEVEL=info

# Nominatim (OpenStreetMap geocoding) requires apps to identify themselves with
# a contact address, and returns 403 to those that don't. Set this to a real
# address. Note that Nominatim blocks by IP RANGE, so you can be blocked because
# of someone else on your ISP — the app falls back to Photon and then to raw
# coordinates, so assessments keep working either way.
NOMINATIM_USER_AGENT=ClimateIQ/1.0 (contact: you@example.com)
